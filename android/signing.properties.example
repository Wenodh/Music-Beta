# Vibe On — Release Signing Configuration Template
# Copy this file to 'signing.properties' in the android/ directory and update with your keystore values.
# NEVER commit 'signing.properties' or keystore (.keystore / .jks) files to version control!

# Path to your release keystore file (relative to android/ directory or absolute path)
RELEASE_STORE_FILE=release-key.keystore

# Keystore password
RELEASE_STORE_PASSWORD=your_keystore_password_here

# Key alias
RELEASE_KEY_ALIAS=your_key_alias_here

# Key password
RELEASE_KEY_PASSWORD=your_key_password_here
